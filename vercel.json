{
  "rewrites": [
    { "source": "/signup/:path*", "destination": "https://leaps-gamma.vercel.app/signup/:path*" },
    { "source": "/login/:path*", "destination": "https://leaps-gamma.vercel.app/login/:path*" },
    { "source": "/dashboard/:path*", "destination": "https://leaps-gamma.vercel.app/dashboard/:path*" },
    { "source": "/onboarding/:path*", "destination": "https://leaps-gamma.vercel.app/onboarding/:path*" },
    { "source": "/auth/:path*", "destination": "https://leaps-gamma.vercel.app/auth/:path*" },
    { "source": "/api/:path*", "destination": "https://leaps-gamma.vercel.app/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://leaps-gamma.vercel.app/_next/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
